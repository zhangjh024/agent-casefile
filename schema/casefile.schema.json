{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhangjh024/agent-casefile/blob/main/schema/casefile.schema.json",
  "title": "Agent Casefile 1.0",
  "description": "Portable recorded boundary evidence and non-executable offline assertions. This schema describes structure; runtime validation additionally checks unique IDs, event references, ordering, bounded JSON data, and completeness.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "agent-casefile"
    },
    "version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["synthetic", "recorded"]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": ["kind"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["name", "version"]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["provider", "name"]
        }
      },
      "required": ["runtime"]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["complete", "partial"]
        },
        "missing": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "required": ["status", "missing"]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "assertions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "redactions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pointer": {
            "$ref": "#/$defs/redactionPointer"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["pointer", "reason"]
      }
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "title",
    "createdAt",
    "provenance",
    "environment",
    "capture",
    "events",
    "assertions"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "json": {
      "$comment": "Any JSON value. The runtime additionally enforces finite numbers, plain objects, forbidden prototype property names, maximum nesting 32, maximum nodes 100000, individual strings 131072 characters, and input size 5 MiB."
    },
    "eventKind": {
      "enum": ["model.request", "model.response", "tool.call", "tool.result", "run.end"]
    },
    "outcome": {
      "enum": ["success", "error", "cancelled"]
    },
    "pointer": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?:/(?:[^~]|~[01])*)*$",
      "not": {
        "pattern": "(?:^|/)(?:__proto__|prototype|constructor)(?:/|$)"
      },
      "$comment": "RFC 6901 JSON pointer, with prototype-related path segments prohibited. For value assertions this is relative to the selected event."
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "model.request"
            },
            "atMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "data": {
              "$ref": "#/$defs/json"
            },
            "callId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": ["id", "kind", "atMs", "data", "callId"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "model.response"
            },
            "atMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "data": {
              "$ref": "#/$defs/json"
            },
            "callId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": ["id", "kind", "atMs", "data", "callId"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "tool.call"
            },
            "atMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "data": {
              "$ref": "#/$defs/json"
            },
            "callId": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["id", "kind", "atMs", "data", "callId", "name"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "tool.result"
            },
            "atMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "data": {
              "$ref": "#/$defs/json"
            },
            "callId": {
              "$ref": "#/$defs/id"
            },
            "outcome": {
              "enum": ["success", "error", "timeout"]
            }
          },
          "required": ["id", "kind", "atMs", "data", "callId", "outcome"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "run.end"
            },
            "atMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "data": {
              "$ref": "#/$defs/json"
            },
            "outcome": {
              "$ref": "#/$defs/outcome"
            }
          },
          "required": ["id", "kind", "atMs", "data", "outcome"]
        }
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "event.exists"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "eventKind": {
              "$ref": "#/$defs/eventKind"
            }
          },
          "required": ["id", "kind", "eventKind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "event.count"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "eventKind": {
              "$ref": "#/$defs/eventKind"
            },
            "equals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": ["id", "kind", "eventKind", "equals"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "value.equals"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "eventId": {
              "$ref": "#/$defs/id"
            },
            "pointer": {
              "$ref": "#/$defs/pointer"
            },
            "expected": {
              "$ref": "#/$defs/json"
            }
          },
          "required": ["id", "kind", "eventId", "pointer", "expected"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "value.absent"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "eventId": {
              "$ref": "#/$defs/id"
            },
            "pointer": {
              "$ref": "#/$defs/pointer"
            }
          },
          "required": ["id", "kind", "eventId", "pointer"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "calls.settled"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "boundary": {
              "enum": ["tool", "model", "all"]
            }
          },
          "required": ["id", "kind", "boundary"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "run.outcome"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "equals": {
              "$ref": "#/$defs/outcome"
            }
          },
          "required": ["id", "kind", "equals"]
        }
      ]
    },
    "redactionPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~]|~[01])*)*$",
      "not": {
        "pattern": "(?:^|/)(?:__proto__|prototype|constructor)(?:/|$)"
      },
      "$comment": "Absolute non-root RFC 6901 JSON pointer into the casefile. Runtime string and total-input limits still apply.",
      "minLength": 1
    }
  }
}
